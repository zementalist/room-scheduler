# Copy to .env and edit. Never commit .env.

# Admin account (re-synced from these values on every start; change the password here and restart)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Public host name served by Caddy with automatic HTTPS.
# Use ":80" for local testing without HTTPS (and set COOKIE_SECURE=false).
DOMAIN=rooms.example.edu
COOKIE_SECURE=true

# Host ports (change for local testing if 80/443 are taken)
HTTP_PORT=80
HTTPS_PORT=443

# Number of daily database snapshots kept in /data/backups
BACKUP_KEEP=14
